* text=auto

*.c text eol=lf
*.h text eol=lf
*.s text eol=lf
*.cmake text eol=lf
*.md text eol=lf
*.txt text eol=lf

# Public-source fingerprints and generated manifests use canonical LF bytes.
tools/timing/** text eol=lf
# Retain the reference snapshot byte-for-byte, including its final blank line.
tools/timing/reference/PPCTables.cpp whitespace=-blank-at-eof

*.dol binary
*.elf binary
*.iso binary
*.gcm binary
*.rpx binary
*.rpl binary
*.wad binary
